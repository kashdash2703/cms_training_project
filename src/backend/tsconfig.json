{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": 
  {
    // File Layout
     "rootDir": "./",
     "outDir": "../../dist/backend",
     "esModuleInterop": true, //default import from commonjs, for express- import from 'express'

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext", //module system, nodenext handles imports
    "target": "esnext", //Javascript version, es2020 or esnext is the latest version
    "types": ["node"],  // type definitions needed
    "moduleResolution": "nodenext",
    // For nodejs:
    // "lib": ["esnext"], //built-in features available
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true, //helpful for debugging, generate .map files for debugging
    "declaration": true, //others need type definitions, generate .d.ts files
    "declarationMap": true, //helps library users debug, genertae .d.ts.map files

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true, // array[0] might be undefined
    "exactOptionalPropertyTypes": true, // strict optional properties

    // Style Options
    "noImplicitReturns": true, // enables all strict checks
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    //"jsx": "react-jsx", //only for frontend
    "verbatimModuleSyntax": true, //"Keep import type separate from import"
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force", // treat all files as modules
    "skipLibCheck": true, // skip type checking node_modules
  }
}

