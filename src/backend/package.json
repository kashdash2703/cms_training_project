{
  "name": "cms-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=.env tsx watch index.ts",
    "test:local": "DOTENV_CONFIG_PATH=.env NODE_ENV=test BACKEND_PORT=3001 tsx watch index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "node ../../dist/backend/index.js",
    "test": "DOTENV_CONFIG_PATH=.env vitest run --config vitest.config.ts",
    "test:watch": "DOTENV_CONFIG_PATH=.env vitest --config vitest.config.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "mongodb": "^7.2.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
