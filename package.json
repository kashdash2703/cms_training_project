{
  "name": "cms_project",
  "version": "1.0.0",
  "description": "Create, Search and Retrieve Articles",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "tsx watch src/backend/index.ts",
    "dev:frontend": "vite --mode development",
    "test:local": "NODE_ENV=test BACKEND_PORT=3001 tsx watch src/backend/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/backend/index.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "mongodb": "^7.2.0",
    "pg": "^8.21.0"
  }
}
